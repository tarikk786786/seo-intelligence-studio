{
  "manifest_version": 3,
  "name": "tarikislamseoamazon",
  "version": "1.0.0",
  "author": "Tarik Islam (tarikislam.in)",
  "homepage_url": "https://tarikislam.in",
  "description": "tarikislamseoamazon - In-SERP Google Search Volume & CPC overlay, Amazon & on-page SEO auditor, schema detector, and Content Editor sync. Made by tarikislam.in",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "tarikislamseoamazon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
