# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="file:./dev.db"

# Redis Queue Configuration (for BullMQ daily prompt refresh worker)
REDIS_URL="redis://localhost:6379"

# Security & Encryption
AUTH_SECRET="super-secret-auth-key-minimum-32-chars-long"
ENCRYPTION_KEY="32-byte-hex-encoded-encryption-key-for-tokens"

# Live SEO / SERP Provider (SerpAPI or DataForSEO)
SERP_PROVIDER="serpapi"
SERP_PROVIDER_API_KEY=""

# AI Visibility & Search Grounding Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Integrations Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
PAGESPEED_API_KEY=""

# Optional Outbound Webhook Signing Secret
WEBHOOK_SIGNING_SECRET=""
